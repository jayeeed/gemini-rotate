# Required: Define your Gemini API keys using the pattern GEMINI_API_KEY_<number>
GEMINI_API_KEY_1="your-gemini-api-key-1"
GEMINI_API_KEY_2="your-gemini-api-key-2"
GEMINI_API_KEY_3="your-gemini-api-key-3"

# Optional: Override the default list of models processed by the client.
# This must be a valid JSON array. Models are processed in pairs (Primary -> Secondary).
# GEMINI_MODELS='["gemini-3.5-flash", "gemini-3.1-flash-lite", "gemini-3-flash-preview"]'

# Optional: LangSmith Tracing configurations
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY="your-langsmith-api-key"
LANGCHAIN_PROJECT="gemini-rotate"
